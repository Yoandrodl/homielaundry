<!-- JAVASCRIPT (satu blok, di bawah body)                        -->
<!-- ============================================================ -->
<script>
  // ── Hamburger menu ────────────────────────────────────────────
  document.getElementById('menu-btn').addEventListener('click', () => {
    document.getElementById('mobile-menu').classList.toggle('hidden');
  });

  // ── Kontak WA ─────────────────────────────────────────────────
  function sendWA() {
    const name = document.getElementById('contact-name').value.trim();
    const msg  = document.getElementById('contact-msg').value.trim();
    const text = `Halo Homie Laundry Samarinda, saya ${name}. ${msg}`;
    window.open('https://wa.me/6281141020169?text=' + encodeURIComponent(text));
  }

  // ── Testimonial ───────────────────────────────────────────────
  // ✅ DIPERBAIKI: Avatar pakai CSS (div warna), tidak perlu request ke server luar
  const testimonials = [
    {
      name:   "Thanya Paramitha",
      initials: "TP",
      color:  "#6366f1",
      stats:  "3 reviews",
      time:   "2 days ago",
      rating: 5,
      quote:  "Lagi dinas dan cari-cari tempat laundry muncul ini. Admin dan kurir pun nya ramah banget dan fast response. Hasil laundry nya juga wangi banget & rapi. Harganya pun sangat affordable. Terimakasih homie laundry"
    },
    {
      name:   "The Rovoly's",
      initials: "TR",
      color:  "#3b82f6",
      stats:  "23 reviews",
      time:   "5 days ago",
      rating: 5,
      quote:  "Luar biasa si, pake paket 3 jam, dan baru 2 jam kurang sudah di antar balik ke hotel. Yes, jasa antar jemputnya free.. terima kasih."
    },
    {
      name:   "Ripakati",
      initials: "RP",
      color:  "#ec4899",
      stats:  "1 review",
      time:   "3 days ago",
      rating: 5,
      quote:  "Alhamdulillah puas sekali dengan pelayanan homie laundry samarinda, selesai sesuai estimasi waktu, sampai malam juga tetep di selesaikan dan di antar, hasil cucian juga rapih, bersih dan wangi."
    }
  ];

  let currentIndex = 0;
  let autoPlay;

  const contentEl  = document.getElementById('testimonial-content');
  const nameEl     = document.getElementById('user-name');
  const avatarEl   = document.getElementById('user-avatar');
  const statsEl    = document.getElementById('user-stats');
  const timeEl     = document.getElementById('review-time');
  const starsEl    = document.getElementById('star-rating');
  const quoteEl    = document.getElementById('user-quote');
  const dotsEl     = document.getElementById('dots-container');

  function renderStars(n) {
    starsEl.innerHTML = Array.from({length: 5}, (_, i) =>
      `<span class="text-xl">${i < n ? '★' : '☆'}</span>`
    ).join('');
  }

  function showTestimonial(index) {
    currentIndex = index;
    contentEl.style.opacity = '0';

    setTimeout(() => {
      const d = testimonials[index];
      avatarEl.textContent        = d.initials;
      avatarEl.style.background   = d.color;
      nameEl.textContent          = d.name;
      statsEl.textContent         = d.stats;
      timeEl.textContent          = d.time;
      quoteEl.textContent         = d.quote;
      renderStars(d.rating);

      document.querySelectorAll('.dot').forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('active', active);
        dot.classList.toggle('bg-blue-600', active);
        dot.classList.toggle('bg-gray-300', !active);
        dot.style.width = active ? '1.5rem' : '0.5rem';
      });

      contentEl.style.opacity = '1';
    }, 300);
  }

  function initDots() {
    dotsEl.innerHTML = '';
    testimonials.forEach((_, i) => {
      const btn = document.createElement('button');
      btn.className = `dot h-2 w-2 rounded-full bg-gray-300 transition-all duration-300${i === 0 ? ' active' : ''}`;
      btn.onclick = () => { clearInterval(autoPlay); showTestimonial(i); startAutoPlay(); };
      dotsEl.appendChild(btn);
    });
  }

  function startAutoPlay() {
    autoPlay = setInterval(() => {
      showTestimonial((currentIndex + 1) % testimonials.length);
    }, 6000);
  }

  initDots();
  showTestimonial(0);
  startAutoPlay();
</script>

</body>
