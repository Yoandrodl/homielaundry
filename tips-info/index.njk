---
layout: layout.njk
title: Tips & Info Laundry Samarinda
eleventyExcludeFromCollections: true
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 md:p-12 mb-8 mt-8">
  <div class="text-center mb-12">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4" style="font-family: 'Playfair Display', serif;">Tips & Info</h1>
    <p class="text-gray-600 max-w-2xl mx-auto text-lg">Temukan berbagai tips perawatan pakaian, trik menghilangkan noda, dan berita terbaru seputar layanan Homie Laundry Samarinda.</p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    {% set postsList = collections.publishedTips | reverse %}
    {% for post in postsList %}
    <a href="{{ post.url }}" class="block bg-white rounded-xl shadow hover:shadow-xl transition-all duration-300 border border-gray-100 overflow-hidden group">
      <div class="p-6">
        <p class="text-xs text-indigo-500 font-bold mb-3 uppercase tracking-wider">{{ post.date | postDate }}</p>
        <h2 class="text-2xl font-bold mb-3 text-gray-800 group-hover:text-indigo-600 transition-colors" style="font-family: 'Playfair Display', serif;">{{ post.data.title }}</h2>
        <p class="text-gray-600 text-sm line-clamp-3 mb-4 leading-relaxed">{{ post.data.description }}</p>
        <span class="inline-flex items-center text-indigo-600 font-semibold text-sm group-hover:translate-x-2 transition-transform">
          Baca artikel <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </span>
      </div>
    </a>
    {% else %}
    <p class="text-center text-gray-500 col-span-full py-12">Belum ada artikel yang diterbitkan. Nantikan update kami segera!</p>
    {% endfor %}
  </div>
</div>
